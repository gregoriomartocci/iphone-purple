# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca se commitean secretos.
# .env.example sí, porque documenta qué variables hacen falta.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test output
/coverage
/playwright-report
/test-results

# capturas generadas para el README
/docs/screenshots/*.tmp.png

# Fotos que mandan los proveedores por WhatsApp. Material de trabajo: se
# miran, se elige, y lo elegido se copia a public/productos/. La carpeta
# entera no va al repo ni se publica.
fotos-proveedor/

# Sesión de WhatsApp Web: son las credenciales de la línea, equivalen a
# la cuenta. Nunca al repo.
.whatsapp-auth/

# Lo que baja el lector de WhatsApp: mensajes de proveedores con precios.
datos-proveedor/

# Registro del lector. Va fuera de .whatsapp-auth porque ese directorio se
# borra entero cuando un intento de vinculación no prospera.
lector-whatsapp.log

# El lector tiene su propio arbol de dependencias: es un proceso aparte y
# Baileys pide una version de sharp que choca con la que necesita Next.
scripts/whatsapp/node_modules/

# El historico de mensajes del lector y el respaldo de su sesion.
historico-whatsapp.ndjson
mensajes-whatsapp.json
.whatsapp-auth-respaldo/
