# ─────────────────────────────────────────────────────────────
# iPhone Purple — variables de entorno
#
# Copiá este archivo a .env.local y completá los valores.
# El sitio ARRANCA SIN NINGUNA de estas variables: sirve el catálogo
# de demostración de lib/data/seed.ts. Se van activando por partes.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Sin esto el sitio usa la semilla y el panel no puede guardar nada.
# Sacalas de: Project Settings → API Keys en tu proyecto de Supabase.
#
# Supabase emite dos juegos de claves y los dos sirven:
#   nuevo   → sb_publishable_… (pública) y sb_secret_… (servidor)
#   legacy  → anon y service_role, que son JWT y empiezan con eyJ
# Las legacy se retiran a fin de 2026, así que en un proyecto nuevo van las
# nuevas. Son cortas: eso es normal, no es que estén truncadas.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ⚠️ Solo servidor. Saltea RLS: nunca la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Autenticación del panel (NextAuth v5) ───────────────────
# Generá el secreto con: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000


# ── Claude (importador de listas de proveedor) ──────────────
# Sacala de: console.anthropic.com → API Keys
#
# Es la única opción que funciona en el servidor, así que la automatización la
# necesita. Dejar acá el texto de relleno es peor que dejarlo vacío: parece
# configurado y falla con un 401 a mitad de una importación.
ANTHROPIC_API_KEY=

# Quién interpreta las listas: api | sesion | auto. Vacío es auto.
#
# Con `auto` se usa la API si hay clave, y si no, la sesión local de Claude
# Code —que sirve para probar en tu máquina sin clave—. La sesión gasta unos
# 33.000 tokens por lista contra 420 de la API, porque arma el armazón entero
# en cada llamada, y no existe en el servidor. Se fuerza uno u otro para
# probar el camino que no se elegiría solo.
INTERPRETE_LISTAS=

# Dónde está el ejecutable de Claude Code, si no está en los lugares de
# siempre. Solo hace falta para el modo sesión y solo si no lo encuentra solo.
CLAUDE_CLI_PATH=

# ── Lector de WhatsApp ──────────────────────────────────────
# El proceso que mantiene la sesión de WhatsApp abierta y guarda los mensajes
# de los últimos días. Corre aparte (Railway), no acá: el sitio arranca y
# muere con cada pedido, y la sesión se caería en cada uno.
# Sin esto, /admin/whatsapp explica qué falta en vez de romperse.
WHATSAPP_SERVIDOR_URL=
# Tiene que ser idéntico al TOKEN_WHATSAPP del servicio. Sin él, cualquiera
# con la URL lee las listas de todos los proveedores.
WHATSAPP_SERVIDOR_TOKEN=

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mercado Pago — sin esto el checkout cierra por WhatsApp en vez de cobrar online.
MP_ACCESS_TOKEN=APP_USR-poner-el-token-real-aca
