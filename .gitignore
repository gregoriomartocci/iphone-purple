# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — nunca se commitean secretos.
# .env.example sí, porque documenta qué variables hacen falta.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test output
/coverage
/playwright-report
/test-results

# capturas generadas para el README
/docs/screenshots/*.tmp.png

# Fotos que mandan los proveedores por WhatsApp. Material de trabajo: se
# miran, se elige, y lo elegido se copia a public/productos/. La carpeta
# entera no va al repo ni se publica.
fotos-proveedor/
